{
  "name": "acontplus-libs",
  "version": "1.0.0",
  "scripts": {
    "start": "nx serve demo-app --ssl --hmr",
    "start:erp": "nx serve acontplus-erp --ssl --hmr --port 4300",
    "build": "nx build demo-app",
    "watch": "nx build demo-app --watch --configuration development",
    "build:all": "nx run-many --target=build --all",
    "build:libs": "nx run-many --target=build --projects=core,ng-auth,ng-components,ng-customer,ng-infrastructure,ng-notifications,ui-kit,utils,ng-common",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "pnpm run format",
    "lint:all": "pnpm run lint && pnpm run format:check",
    "clean": "nx reset",
    "local-registry": "nx run acontplus-libs:local-registry",
    "e2e": "nx run demo-app-e2e:e2e",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@acontplus/core": "workspace:^",
    "@acontplus/ng-auth": "workspace:^",
    "@acontplus/ng-common": "workspace:^",
    "@acontplus/ng-components": "workspace:^",
    "@acontplus/ng-config": "workspace:^",
    "@acontplus/ng-customer": "workspace:^",
    "@acontplus/ng-infrastructure": "workspace:^",
    "@acontplus/ng-notifications": "workspace:^",
    "@acontplus/ui-kit": "workspace:^",
    "@acontplus/utils": "workspace:^",
    "@angular/animations": "22.1.0",
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/material": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/platform-browser-dynamic": "22.1.0",
    "@angular/platform-server": "22.1.0",
    "@angular/router": "22.1.0",
    "@angular/ssr": "22.1.2",
    "@formkit/tempo": "1.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-select/ng-select": "23.5.1",
    "bootstrap": "^5.3.8",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "highlight.js": "11.11.1",
    "jsonwebtoken": "9.0.3",
    "jwt-decode": "^4.0.0",
    "ngx-datex": "1.0.5",
    "ngx-permissions": "^19.0.0",
    "ngx-progressbar": "^14.0.0",
    "ngx-toastr": "^20.0.5",
    "rollup": "4.62.4",
    "rxjs": "^7.8.2",
    "screenfull": "^6.0.2",
    "sweetalert2": "^11.26.25",
    "tabulator-tables": "^6.5.2",
    "tslib": "^2.8.1",
    "uuid": "13.0.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.2",
    "@angular-devkit/schematics": "22.1.2",
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/rollup": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.62.1",
    "@schematics/angular": "22.1.2",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.3.5",
    "@types/tabulator-tables": "^6.3.6",
    "@typescript-eslint/utils": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "ajv": "^8.20.0",
    "angular-eslint": "22.1.0",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "2.11.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "^3.1.0",
    "lint-staged": "16.3.2",
    "ng-packagr": "22.1.0",
    "nx": "23.1.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "ts-node": "10.9.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.65.0",
    "verdaccio": "6.9.0",
    "vite": "8.2.0",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,cts,mts,html,css,scss,sass,json,yml,yaml,md}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "nx run-many --target=lint --files"
    ]
  },
  "nx": {
    "includedScripts": []
  }
}
