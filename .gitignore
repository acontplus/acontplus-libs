# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Dependencies, builds, caches, and test results
node_modules/
dist/
coverage/
out-tsc/
bazel-out/
tmp/
temp/
.angular/
.nx/*
!.nx/version-plans/
!.nx/version-plans/*.md
*.tsbuildinfo
*.timestamp*

# Logs and runtime files
*.log
*.pid
*.pid.lock
*.seed
*.lcov
testem.log
libpeerconnection.log
connect.lock

# Environment files (examples are intentionally committed)
.env*
!**/.env.example

# Editors and IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.vs/
.history/
.settings/
.project
.classpath
.c9/
*.launch
*.sublime-workspace
*.swp
*.swo
*~

# Operating-system files
.DS_Store
Thumbs.db

# Local tool state
.eslintcache
.sass-cache/
.claude/worktrees/
